[sub_resource type="GDScript" id="GDScript_xn18l"]
script/source = "extends CharacterBody2D

const SPEED   := 200.0
const GRAVITY := 980.0

var is_attacking := false
var facing       := 1   # 1 = right, -1 = left

@onready var anim    := $AnimatedSprite2D
@onready var hitbox	 := $AttackHitbox
@onready var hitbox_col  := $AttackHitbox/CollisionShape2D

func _ready():
	# Hitbox starts disabled — only active during attack
	hitbox.monitoring = false

	# When the attack animation finishes, end the attack
	anim.animation_finished.connect(_on_animation_finished)

func _physics_process(delta):
	# Gravity
	if not is_on_floor():
		velocity.y += GRAVITY * delta

	# Don't allow movement or new attacks while attacking
	if not is_attacking:
		_handle_movement()
		_handle_attack_input()

	move_and_slide()
	_update_animation()

func _handle_movement():
	var dir = Input.get_axis(\"ui_left\", \"ui_right\")

	if dir != 0:
		velocity.x   = dir * SPEED
		facing        = int(sign(dir))
		anim.flip_h   = facing == -1
		# Keep hitbox in front of the player
		hitbox.position.x *= facing # * 40
	else:
		velocity.x = move_toward(velocity.x, 0, SPEED)

func _handle_attack_input():
	if Input.is_action_just_pressed(\"ui_accept\"):
		_start_attack()

func _start_attack():
	is_attacking      = true
	anim.play(\"attack\")

	# Small delay before hitbox activates (startup frames)
	await get_tree().create_timer(0.1).timeout
	hitbox.monitoring = true

	# Hitbox stays active for a short window
	await get_tree().create_timer(0.15).timeout
	hitbox.monitoring = false

func _on_animation_finished():
	if anim.animation == \"attack\":
		is_attacking = false

func _update_animation():
	if not is_attacking:
		anim.play(\"idle\")
"

